#!/usr/bin/env bash
# Ctrl+Alt+V -- hands-free toggle (start talking / stop and type it out).
# Push-to-talk on Alt_R is handled by the baogu-ptt daemon, not by this.
set -u
source "$(cd -- "$(dirname -- "$0")" && pwd)/baogu-lib.sh"

baogu_lock
case "$(baogu_state)" in
  recording) baogu_suspend ;;
  suspended) baogu_resume ;;
  none|starting) baogu_ensure_daemon && baogu_resume ;;
esac
baogu_unlock
