#!/usr/bin/env bash
# Emergency: kill every dictation process and stray recorder.
# Also stops the push-to-talk daemon, unless --keep-service is given (which is
# what the unit's ExecStopPost uses, to avoid recursing into systemctl stop).
set -u
source "$(cd -- "$(dirname -- "$0")" && pwd)/baogu-lib.sh"

if [ "${1:-}" != "--keep-service" ]; then
  systemctl --user stop baogu-overlay.service >/dev/null 2>&1 || true
  systemctl --user stop "$UNIT" >/dev/null 2>&1 || true
  pkill -u "$(id -u)" -f -- "^[^ ]*python[0-9.]* $ROOT/baogu-ptt" 2>/dev/null || true
fi

baogu_lock
baogu_kill_all
baogu_unlock
echo "baogu: all stopped"
