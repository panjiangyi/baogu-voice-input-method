def load_project_env() -> None:
    """Load simple KEY=VALUE entries without adding a dotenv dependency."""
    path = ROOT / ".env"
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return
    for raw in lines:
        raw = raw.strip()
        if not raw or raw.startswith("#") or "=" not in raw:
            continue
        key, value = raw.split("=", 1)
        key = key.strip()
        if not key or key in os.environ:
            continue
        try:
            parsed = shlex.split(value, comments=True)
        except ValueError:
            continue
        os.environ[key] = parsed[0] if parsed else ""


def log(msg: str) -> None:
    sys.stderr.write(f"[baogu-engine] {msg}\n")
    sys.stderr.flush()


def set_state(state: str) -> None:
    try:
        STATE_FILE.write_text(state + "\n", encoding="utf-8")
    except OSError:
        pass


def pause_other_media() -> None:
    """Pause other playing audio in the background; never delays recording."""
    if os.environ.get("BAOGU_PAUSE_MEDIA", "1") != "1":
        return

    def run() -> None:
        try:
            paused = pause_playing()
        except Exception as ex:
            log(f"pause media failed: {ex!r}")
            return
        if paused:
            log(f"paused media: {', '.join(paused)}")

    threading.Thread(target=run, name="pause-media", daemon=True).start()


def set_correction_state(session: str, status: str) -> None:
    try:
        CORRECTION_FILE.write_text(
            json.dumps({"session": session, "status": status, "time": time.time()}),
            encoding="utf-8",
        )
    except OSError:
        pass


def take_ask_request() -> dict | None:
    """Consume the pending selection-question request, if any."""
    try:
        raw = ASK_REQUEST_FILE.read_text(encoding="utf-8")
    except OSError:
        return None
    try:
        ASK_REQUEST_FILE.unlink(missing_ok=True)
    except OSError:
        pass
    try:
        data = json.loads(raw)
    except ValueError:
        return None
    return data if isinstance(data, dict) else None


def write_ask_state(session: str, status: str, **fields) -> None:
    """Publish ask progress atomically so the window never reads a torn file."""
    payload = {"session": session, "status": status, "time": time.time()}
    payload.update(fields)
    try:
        temporary = ASK_STATE_FILE.with_name(ASK_STATE_FILE.name + ".tmp")
        temporary.write_text(
            json.dumps(payload, ensure_ascii=False), encoding="utf-8"
        )
        temporary.replace(ASK_STATE_FILE)
    except OSError:
        pass


class FcitxBridge:
    """Session-aware Fcitx D-Bus client."""

    def __init__(self) -> None:
        self._gio = None
        self._bus = None
        try:
            import gi
            from gi.repository import Gio, GLib  # type: ignore
            self._gio = (Gio, GLib)
            self._bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        except Exception as ex:
            log(f"Gio unavailable, using busctl fallback: {ex!r}")

    def _gio_call(self, method: str, params):
        Gio, GLib = self._gio
        reply = self._bus.call_sync(
            "org.baogu.Input",
            "/org/baogu/Input",
            "org.baogu.Input1",
            method,
            params,
            GLib.VariantType("(b)"),
            Gio.DBusCallFlags.NONE,
            1200,
            None,
        )
        return bool(reply.unpack()[0])

    def begin(self, session: str) -> bool:
        if self._bus is not None and self._gio is not None:
            _Gio, GLib = self._gio
            return self._gio_call(
                "BeginSession", GLib.Variant("(s)", (session,))
            )
        out = subprocess.run(
            [
                "busctl", "--user", "--timeout=1", "call",
                "org.baogu.Input", "/org/baogu/Input",
                "org.baogu.Input1", "BeginSession", "s", session,
            ],
            capture_output=True, text=True, timeout=1.5,
        )
        return out.returncode == 0 and out.stdout.strip() == "b true"

    def context(self, session: str) -> dict[str, str]:
        """Optional bridge extension; older addons simply provide no context."""
        try:
            if self._bus is not None and self._gio is not None:
                Gio, GLib = self._gio
                reply = self._bus.call_sync(
                    "org.baogu.Input", "/org/baogu/Input",
                    "org.baogu.Input1", "ContextSession",
                    GLib.Variant("(s)", (session,)), GLib.VariantType("(sss)"),
                    Gio.DBusCallFlags.NONE, 250, None,
                )
                values = reply.unpack()
            else:
                reply = subprocess.run(
                    ["busctl", "--user", "--timeout=0.25", "call",
                     "org.baogu.Input", "/org/baogu/Input",
                     "org.baogu.Input1", "ContextSession", "s", session],
                    capture_output=True, text=True, timeout=0.4,
                )
                values = shlex.split(reply.stdout)
                if reply.returncode or not values or values.pop(0) != "sss":
                    return {}
            app, before, after = values
            return {"app": app[:128], "before": before[-500:], "after": after[:500]}
        except Exception:
            return {}

    def update(self, session: str, remove: int, text: str) -> bool:
        if self._bus is not None and self._gio is not None:
            _Gio, GLib = self._gio
            return self._gio_call(
                "UpdateSession",
                GLib.Variant("(sis)", (session, remove, text)),
            )
        out = subprocess.run(
            [
                "busctl", "--user", "--timeout=1", "call",
                "org.baogu.Input", "/org/baogu/Input",
                "org.baogu.Input1", "UpdateSession", "sis",
                session, str(remove), text,
            ],
            capture_output=True, text=True, timeout=1.5,
        )
        return out.returncode == 0 and out.stdout.strip() == "b true"

    def finish(self, session: str, text: str) -> bool:
        """Atomically replace the live preedit and commit one final result."""
        if self._bus is not None and self._gio is not None:
            _Gio, GLib = self._gio
            return self._gio_call(
                "FinishSession",
                GLib.Variant("(ss)", (session, text)),
            )
        out = subprocess.run(
            [
                "busctl", "--user", "--timeout=1", "call",
                "org.baogu.Input", "/org/baogu/Input",
                "org.baogu.Input1", "FinishSession", "ss",
                session, text,
            ],
            capture_output=True, text=True, timeout=1.5,
        )
        return out.returncode == 0 and out.stdout.strip() == "b true"

    def preview(self, session: str, text: str) -> bool:
        if self._bus is not None and self._gio is not None:
            _Gio, GLib = self._gio
            return self._gio_call(
                "PreviewSession", GLib.Variant("(ss)", (session, text))
            )
        out = subprocess.run(
            [
                "busctl", "--user", "--timeout=1", "call",
                "org.baogu.Input", "/org/baogu/Input",
                "org.baogu.Input1", "PreviewSession", "ss", session, text,
            ],
            capture_output=True, text=True, timeout=1.5,
        )
        return out.returncode == 0 and out.stdout.strip() == "b true"

    def commit(self, session: str, text: str) -> bool:
        if self._bus is not None and self._gio is not None:
            _Gio, GLib = self._gio
            return self._gio_call(
                "CommitSession", GLib.Variant("(ss)", (session, text))
            )
        out = subprocess.run(
            [
                "busctl", "--user", "--timeout=1", "call",
                "org.baogu.Input", "/org/baogu/Input",
                "org.baogu.Input1", "CommitSession", "ss", session, text,
            ],
            capture_output=True, text=True, timeout=1.5,
        )
        return out.returncode == 0 and out.stdout.strip() == "b true"

    def cancel(self, session: str) -> bool:
        if self._bus is not None and self._gio is not None:
            _Gio, GLib = self._gio
            return self._gio_call(
                "CancelSession", GLib.Variant("(s)", (session,))
            )
        out = subprocess.run(
            [
                "busctl", "--user", "--timeout=1", "call",
                "org.baogu.Input", "/org/baogu/Input",
                "org.baogu.Input1", "CancelSession", "s", session,
            ],
            capture_output=True, text=True, timeout=1.5,
        )
        return out.returncode == 0 and out.stdout.strip() == "b true"


class TextReconciler:
    def __init__(self, bridge: FcitxBridge, session: str) -> None:
        self.bridge = bridge
        self.session = session
        self.current = ""
        self.last_emit = 0.0

    @staticmethod
    def patch(old: str, new: str) -> tuple[int, str]:
        # Updates replace the changed tail. Keeping a common suffix is not
        # valid here: the bridge cursor is always at the end, so it cannot
        # edit a middle range without also replacing the suffix after it.
        n = min(len(old), len(new))
        i = 0
        while i < n and old[i] == new[i]:
            i += 1
        return len(old) - i, new[i:]

    def emit(self, text: str, *, force: bool = False) -> bool:
        text = text.strip()
        if text == self.current:
            return True
        now = time.monotonic()
        if not force and now - self.last_emit < PARTIAL_MIN_INTERVAL:
            return True
        remove, append = self.patch(self.current, text)
        if not self.bridge.update(self.session, remove, append):
            return False
        self.current = text
        self.last_emit = now
        return True


class PreeditPresenter:
    """Throttle live ASR previews without writing them into the document."""

    def __init__(self, bridge: FcitxBridge, session: str) -> None:
        self.bridge = bridge
        self.session = session
        self.current = ""
        self.last_emit = 0.0

    def emit(self, text: str, *, force: bool = False) -> bool:
        text = text.strip()
        if text == self.current:
            return True
        now = time.monotonic()
        if not force and now - self.last_emit < PARTIAL_MIN_INTERVAL:
            return True
        if not self.bridge.preview(self.session, text):
            return False
        self.current = text
        self.last_emit = now
        return True


FINAL_WORKERS = 2
final_running = 0
# The offline pass runs while the streaming recognizer is still alive, and
# onnxruntime keeps its worker threads spinning for a moment after every
# decode. Fewer final threads leave more cores to the streaming model and
# the punctuation model, which is what keeps the wait budget reachable.
FINAL_THREADS = max(1, int(os.environ.get("BAOGU_FINAL_THREADS", "4")))
# These backends emit their own punctuation; the local punctuation model would
# only add a second set of marks on top of it.
NATIVE_PUNCTUATION_BACKENDS = {"qwen3", "funasr-nano"}


def _run_final(final_asr, pcm: bytes) -> str:
    """Run one offline pass and keep the running count in sync."""
    global final_running
    final_running += 1
    try:
        return final_asr.transcribe(pcm)
    finally:
        final_running -= 1


class FinalRecognizer:
    """Offline acoustic final pass; the LLM-style backends take hotwords."""

    def __init__(self) -> None:
        self.recognizer = None
        self.enabled = os.environ.get("BAOGU_FINAL_ENABLED", "1").lower() in {
            "1", "true", "yes", "on"
        }
        if not self.enabled:
            log("final ASR disabled")
            return

        # Fun-ASR-Nano is the default: on the natural-accent set it commits a
        # markedly more accurate final text than Paraformer, and it accepts
        # decoder-time hotwords, so the user's own vocabulary reaches the
        # recognizer instead of only the post-hoc glossary.
        self.backend = os.environ.get("BAOGU_FINAL_BACKEND", "funasr-nano").lower()
        if self.backend == "qwen3":
            self._load_qwen3()
            return
        if self.backend in {"firered2-ctc", "firered2-aed"}:
            self._load_firered2()
            return
        if self.backend == "funasr-nano":
            self._load_funasr_nano()
            if self.recognizer is None:
                # The model is a 1 GB download. If it is missing, keep the
                # final pass alive on Paraformer instead of degrading to the
                # streaming text only.
                log("Fun-ASR-Nano unavailable; falling back to the Paraformer final pass")
                self.backend = "paraformer"
                self._load_paraformer()
            return
        if self.backend != "paraformer":
            raise ValueError(f"Unknown BAOGU_FINAL_BACKEND: {self.backend}")
        self._load_paraformer()

    def _load_paraformer(self) -> None:
        """The small offline model; a safe fallback and the old default."""
        model_dir = Path(os.environ.get(
            "BAOGU_FINAL_MODEL",
            ROOT / "models" / "sherpa-onnx-paraformer-zh-2024-03-09",
        ))
        model = model_dir / "model.int8.onnx"
        tokens = model_dir / "tokens.txt"
        if not model.exists() or not tokens.exists():
            log("offline Paraformer final model not installed; streaming result will be used")
            return
        try:
            import sherpa_onnx
            self.recognizer = sherpa_onnx.OfflineRecognizer.from_paraformer(
                paraformer=str(model),
                tokens=str(tokens),
                num_threads=max(1, min(FINAL_THREADS, (os.cpu_count() or 2) // 2)),
            )
            log(f"loaded offline Paraformer final model from {model_dir}")
        except Exception as ex:
            log(f"failed to load final ASR model: {ex!r}")
            self.recognizer = None

    def _load_firered2(self) -> None:
        """Keep full AED and the faster CTC-only export distinguishable."""
        ctc = self.backend == "firered2-ctc"
        model_dir = Path(os.environ.get(
            "BAOGU_FINAL_MODEL",
            ROOT / "models" / (
                "sherpa-onnx-fire-red-asr2-ctc-zh_en-int8-2026-02-25" if ctc else
                "sherpa-onnx-fire-red-asr2-zh_en-int8-2026-02-26"
            ),
        ))
        files = ("model.int8.onnx", "tokens.txt") if ctc else (
            "encoder.int8.onnx", "decoder.int8.onnx", "tokens.txt")
        if not all((model_dir / name).is_file() for name in files):
            log(f"{self.backend} model incomplete; streaming result will be used")
            return
        try:
            import sherpa_onnx
            common = dict(tokens=str(model_dir / "tokens.txt"), num_threads=FINAL_THREADS)
            if ctc:
                self.recognizer = sherpa_onnx.OfflineRecognizer.from_fire_red_asr_ctc(
                    model=str(model_dir / "model.int8.onnx"), **common)
            else:
                self.recognizer = sherpa_onnx.OfflineRecognizer.from_fire_red_asr(
                    encoder=str(model_dir / "encoder.int8.onnx"),
                    decoder=str(model_dir / "decoder.int8.onnx"), **common)
            log(f"loaded {self.backend} final model from {model_dir}")
        except Exception as ex:
            log(f"failed to load {self.backend}: {ex!r}")
            self.recognizer = None

    @staticmethod
    def _hotword_prompt() -> str:
        """Decoder-time vocabulary hints for the LLM-style final backends.

        An explicit BAOGU_ASR_HOTWORDS list wins over the file vocabulary: the
        personal glossary is large and mostly work terms, so a focused list is
        the only way to bias the decoder towards the few words the user
        actually says. Without one, the prompt carries the terms the user
        added most recently (the tail of the personal glossary) followed by
        the curated priority list, bounded by BAOGU_ASR_HOTWORDS_MAX_CHARS.
        """
        limit = max(0, int(os.environ.get("BAOGU_ASR_HOTWORDS_MAX_CHARS", "200")))
        recent = max(0, int(os.environ.get("BAOGU_ASR_HOTWORDS_RECENT", "8")))
        explicit = os.environ.get("BAOGU_ASR_HOTWORDS", "").strip()
        if explicit:
            terms = [part.strip() for part in explicit.split(",") if part.strip()]
        else:
            from baogu_glossary import load_recent_terms, load_terms
            terms = load_recent_terms(recent) + load_terms()
        selected, seen = [], set()
        for term in terms:
            if term.casefold() in seen or "," in term:
                continue
            if len(",".join(selected + [term])) > limit:
                break
            selected.append(term)
            seen.add(term.casefold())
        return ",".join(selected)

    def _load_funasr_nano(self) -> None:
        """Fun-ASR-Nano: Paraformer encoder plus a small decoder language model."""
        model_dir = Path(os.environ.get(
            "BAOGU_FINAL_MODEL",
            ROOT / "models" / "sherpa-onnx-funasr-nano-int8-2025-12-30",
        ))
        required = ("encoder_adaptor.int8.onnx", "llm.int8.onnx", "embedding.int8.onnx")
        tokenizer = model_dir / "Qwen3-0.6B"
        missing = [name for name in required if not (model_dir / name).is_file()]
        if missing or not tokenizer.is_dir():
            log(f"Fun-ASR-Nano final model incomplete ({', '.join(missing) or 'tokenizer'}); "
                "streaming result will be used")
            return
        try:
            import sherpa_onnx
            hotwords = self._hotword_prompt()
            self.recognizer = sherpa_onnx.OfflineRecognizer.from_funasr_nano(
                encoder_adaptor=str(model_dir / "encoder_adaptor.int8.onnx"),
                llm=str(model_dir / "llm.int8.onnx"),
                embedding=str(model_dir / "embedding.int8.onnx"),
                tokenizer=str(tokenizer),
                num_threads=FINAL_THREADS,
                hotwords=hotwords,
            )
            log(f"loaded funasr-nano final model from {model_dir} "
                f"with {len(hotwords.split(',')) if hotwords else 0} acoustic hotwords")
        except Exception as ex:
            log(f"failed to load funasr-nano: {ex!r}")
            self.recognizer = None

    def _load_qwen3(self) -> None:
        model_dir = Path(os.environ.get(
            "BAOGU_FINAL_MODEL",
            ROOT / "models" / "sherpa-onnx-qwen3-asr-0.6B-int8-2026-03-25",
        ))
        required = ("conv_frontend.onnx", "encoder.int8.onnx", "decoder.int8.onnx",
                    "tokenizer/vocab.json", "tokenizer/merges.txt", "tokenizer/tokenizer_config.json")
        if not all((model_dir / name).is_file() for name in required):
            log("Qwen3 final model incomplete; streaming result will be used")
            return
        try:
            import sherpa_onnx
            # Keep prompt bounded; user vocabulary takes precedence. Huge
            # dictionaries consume decoder context and dilute useful hints.
            hotwords = self._hotword_prompt()
            self.recognizer = sherpa_onnx.OfflineRecognizer.from_qwen3_asr(
                conv_frontend=str(model_dir / "conv_frontend.onnx"),
                encoder=str(model_dir / "encoder.int8.onnx"),
                decoder=str(model_dir / "decoder.int8.onnx"),
                tokenizer=str(model_dir / "tokenizer"),
                num_threads=FINAL_THREADS,
                max_total_len=2048,
                max_new_tokens=512,
                hotwords=hotwords,
            )
            log(f"loaded Qwen3 final model with "
                f"{len(hotwords.split(',')) if hotwords else 0} acoustic hotwords")
        except Exception as ex:
            log(f"failed to load Qwen3 final model: {ex!r}")
            self.recognizer = None

    def transcribe(self, pcm: bytes) -> str:
        if self.recognizer is None or len(pcm) < SAMPLE_RATE:
            return ""
        if len(pcm) & 1:
            pcm = pcm[:-1]
        samples = np.frombuffer(pcm, dtype=np.int16).astype(np.float32) / 32768.0
        stream = self.recognizer.create_stream()
        stream.accept_waveform(SAMPLE_RATE, samples)
        self.recognizer.decode_stream(stream)
        result = stream.result
        return (result.text if hasattr(result, "text") else str(result)).strip()


class PunctuationRestorer:
    """Fast local punctuation restoration with a semantic fail-closed guard."""

    def __init__(self) -> None:
        self.restorer = None
        self.enabled = os.environ.get(
            "BAOGU_PUNCTUATION_ENABLED", "1"
        ).lower() in {"1", "true", "yes", "on"}
        if not self.enabled:
            return
        model_dir = Path(os.environ.get(
            "BAOGU_PUNCTUATION_MODEL",
            ROOT / "models"
            / "sherpa-onnx-punct-ct-transformer-zh-en-vocab272727-2024-04-12-int8",
        ))
        model = model_dir / "model.int8.onnx"
        if not model.exists():
            log("punctuation model not installed; punctuation restoration disabled")
            return
        try:
            import sherpa_onnx
            config = sherpa_onnx.OfflinePunctuationConfig(
                model=sherpa_onnx.OfflinePunctuationModelConfig(
                    ct_transformer=str(model),
                    num_threads=1,
                    provider="cpu",
                )
            )
            self.restorer = sherpa_onnx.OfflinePunctuation(config)
            log(f"loaded punctuation model from {model_dir}")
        except Exception as ex:
            log(f"failed to load punctuation model: {ex!r}")
            self.restorer = None

    def correct(self, text: str) -> str:
        if not text or self.restorer is None:
            return text
        try:
            candidate = self.restorer.add_punctuation(text).strip()
        except Exception as ex:
            log(f"punctuation restoration failed: {ex!r}")
            return text
        if not candidate:
            return text
        if LLMCorrector._semantic_signature(text) != LLMCorrector._semantic_signature(
            candidate
        ):
            log("punctuation candidate rejected by semantic guard")
            return text
        return candidate


