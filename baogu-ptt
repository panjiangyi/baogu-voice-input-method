#!/usr/bin/env python3
"""Baogu IME push-to-talk supervisor.

The Sherpa engine is a long-lived event-driven process:
  SIGUSR2 = start recording
  SIGUSR1 = stop current recording

Final FireRed/LLM refinement is asynchronous inside the engine, so release
never blocks this xinput event loop and the next press can start immediately.
"""
import json
from baogu_settings import CorrectionShortcut, toggle_llm
from baogu_selection import capture_clipboard, capture_selection

import errno
import fcntl
import os
import re
import shutil
import signal
import subprocess
import sys
import time

ROOT = os.path.dirname(os.path.realpath(__file__))
SHERPA_ENGINE = os.path.join(ROOT, "baogu-engine")
ND = os.path.join(ROOT, "nerd-dictation", "nerd-dictation")
VOSK_MODEL = os.path.join(ROOT, "models", "vosk-model-small-cn-0.22")
RUNTIME = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
COOKIE = os.path.join(RUNTIME, "baogu-%d.cookie" % os.getuid())
LOCK = os.path.join(RUNTIME, "baogu-ptt.lock")
READY = os.path.join(RUNTIME, "baogu-engine.ready")
STATE = os.path.join(RUNTIME, "baogu-engine.state")
ENGINE_MODE = os.environ.get("BAOGU_ENGINE", "sherpa").lower()
KEYCODE = int(os.environ.get("BAOGU_PTT_KEYCODE", "108"))
ASK_ENABLED = os.environ.get("BAOGU_ASK_ENABLED", "1") == "1"
ASK_KEYCODE = int(os.environ.get("BAOGU_ASK_KEYCODE", "38"))  # 'a' on evdev
ASK_MODIFIER = int(os.environ.get("BAOGU_ASK_MODIFIER_KEYCODE", "64"))  # left Alt
ASK_REQUEST = os.path.join(RUNTIME, "baogu-ask.request")
ASK_STATE = os.path.join(RUNTIME, "baogu-ask.state")
ASK_WINDOW = os.path.join(ROOT, "baogu-ask")
# Left Alt + W teaches the currently selected text as a personal hotword, so
# recurring names no longer need a hand-edited glossary file.
HOTWORD_ENABLED = os.environ.get("BAOGU_HOTWORD_ENABLED", "1") == "1"
# Keycodes come from the X keymap, not from a fixed table: this machine's map
# is offset by 8 from the PC105 reference (a=38 here, not 30), the same offset
# the ask shortcut's 38 already relies on. Check yours with:
#   DISPLAY=:1 xmodmap -pke | grep ' = w '
HOTWORD_KEYCODE = int(os.environ.get("BAOGU_HOTWORD_KEYCODE", "25"))  # 'w'
HOTWORD_MODIFIER = int(os.environ.get(
    "BAOGU_HOTWORD_MODIFIER_KEYCODE", "64"))  # left Alt
HOTWORD_SCRIPT = os.path.join(ROOT, "baogu-hotwords")
# A glossary entry is a term, not a paragraph: keep one line and bound the size
# so a runaway paragraph selection cannot bloat every later correction.
HOTWORD_MAX_CHARS = int(os.environ.get("BAOGU_HOTWORD_MAX_CHARS", "80"))

EVENT_RE = re.compile(r"^EVENT type \d+ \((RawKeyPress|RawKeyRelease)\)")
DETAIL_RE = re.compile(r"^\s+detail: (\d+)")
DEVICE_RE = re.compile(r"^\s+device:\s+\d+\s+\((\d+)\)")


class KeyEvents:
    def __init__(self, synthetic_devices):
        self.synthetic_devices = synthetic_devices
        self.pending = None
        self.device = None

    def feed(self, line):
        if line.startswith("EVENT"):
            match = EVENT_RE.match(line)
            self.pending = match.group(1) if match else None
            self.device = None
        match = DEVICE_RE.match(line)
        if match:
            self.device = int(match.group(1))
        match = DETAIL_RE.match(line)
        if match and self.pending:
            event, self.pending = self.pending, None
            if self.device is not None and self.device not in self.synthetic_devices:
                return event, int(match.group(1))
        return None


class AskShortcut:
    """Left Alt + a letter, hold-to-talk for the selection question feature.

    Right Alt is the dictation key, so ask uses left Alt to stay independent.
    Pressing the letter with only left Alt held starts; releasing either key
    stops. The same detector drives the hotword combo, which only uses "press".
    """

    # X11 evdev keycodes: Shift, Ctrl, Alt, Super, and ISO Level3 Shift.
    MODIFIERS = frozenset({50, 62, 37, 105, 64, 108, 133, 134, 92})

    def __init__(self, keycode=None, modifier=None):
        self.keycode = ASK_KEYCODE if keycode is None else keycode
        self.modifier = ASK_MODIFIER if modifier is None else modifier
        self.pressed = set()
        self.active = False

    def feed(self, event, keycode):
        if event == "RawKeyPress":
            repeated = keycode in self.pressed
            self.pressed.add(keycode)
            if (not self.active and keycode == self.keycode and not repeated
                    and self.modifier in self.pressed
                    and not (self.pressed & (self.MODIFIERS - {self.modifier}))):
                self.active = True
                return "press"
            return None
        had = keycode in self.pressed
        self.pressed.discard(keycode)
        if self.active and had and keycode in (self.keycode, self.modifier):
            self.active = False
            return "release"
        return None


def log(msg):
    sys.stderr.write("[baogu-ptt] %s\n" % msg)
    sys.stderr.flush()


def write_ask_request(selection, clipboard=""):
    temporary = ASK_REQUEST + ".tmp"
    try:
        with open(temporary, "w", encoding="utf-8") as fh:
            json.dump({"selection": selection, "clipboard": clipboard,
                       "time": time.time()}, fh)
        os.replace(temporary, ASK_REQUEST)
    except OSError as ex:
        log("cannot write ask request: %r" % (ex,))
    # Drop the previous answer so the window shows "listening" immediately
    # instead of the last question's answer while this one is being recorded.
    try:
        os.unlink(ASK_STATE)
    except OSError:
        pass


def notify(summary, body=""):
    """Best-effort desktop notification; silence is acceptable."""
    try:
        subprocess.Popen(
            ["notify-send", "-a", "Baogu IME", "-t", "4000", summary, body],
            env=child_env(), start_new_session=True,
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError as ex:
        log("cannot show notification: %r" % (ex,))


def normalize_hotword(text):
    """Reduce a selection to a single-line term, or "" when unusable."""
    for line in (text or "").splitlines():
        term = line.strip()
        if term:
            return term[:HOTWORD_MAX_CHARS]
    return ""


def add_hotword_from_selection():
    """Teach the selected (else clipboard) text as a personal hotword.

    Runs inside this daemon, so the glossary rebuild must not restart the
    service that is calling it. The engine re-reads the glossary files when
    they change, so the term still takes effect without a restart.
    """
    term = normalize_hotword(capture_selection())
    source = "选区"
    if not term:
        term = normalize_hotword(capture_clipboard())
        source = "剪贴板"
    if not term:
        log("hotword press: nothing selected")
        notify("没有可添加的常用词", "请先选中或复制这个词")
        return
    env = child_env()
    env["BAOGU_HOTWORDS_NO_RESTART"] = "1"
    try:
        done = subprocess.run(
            [HOTWORD_SCRIPT, "add", term], env=env, text=True,
            capture_output=True, timeout=60,
        )
    except (OSError, subprocess.SubprocessError) as ex:
        log("cannot add hotword: %r" % (ex,))
        notify("添加常用词失败", term)
        return
    output = (done.stdout or "").strip()
    if done.returncode != 0:
        log("hotword add failed rc=%d: %s" % (done.returncode, output))
        notify("添加常用词失败", term)
        return
    log("hotword added from %s: %s" % (source, term))
    notify("已加入常用词（%s）" % source, term)


def ensure_ask_window():
    if not os.path.isfile(ASK_WINDOW):
        return
    try:
        subprocess.Popen(
            [ASK_WINDOW], env=child_env(), start_new_session=True,
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError as ex:
        log("cannot start ask window: %r" % (ex,))


def child_env():
    env = os.environ.copy()
    env.setdefault("DISPLAY", ":1")
    env["LD_LIBRARY_PATH"] = os.path.join(ROOT, "bin") + ":" + env.get("LD_LIBRARY_PATH", "")
    env["PATH"] = os.path.join(ROOT, "bin") + ":" + env.get("PATH", "")
    env["BAOGU_TRACE"] = "1"
    return env


def proc_state(pid):
    try:
        with open("/proc/%d/stat" % pid, "rb") as fh:
            data = fh.read()
    except OSError:
        return None
    return data[data.rindex(b")") + 2:data.rindex(b")") + 3].decode()


class Engine:
    def __init__(self):
        self.proc = None

    def alive(self):
        return self.proc is not None and self.proc.poll() is None

    def command(self):
        if ENGINE_MODE == "vosk":
            return [
                ND, "begin", "--suspend-on-start", "--sample-rate", "16000",
                "--cookie", COOKIE, "--vosk-model-dir", VOSK_MODEL,
                "--idle-time", "0.02", "--simulate-input-tool", "FCITX", "--verbose", "1",
            ]
        return [SHERPA_ENGINE]

    def start(self):
        self.stop()
        for path in (READY, STATE):
            try:
                os.unlink(path)
            except OSError:
                pass
        log("starting %s engine" % ENGINE_MODE)
        self.proc = subprocess.Popen(
            self.command(), env=child_env(), start_new_session=True
        )

        if ENGINE_MODE == "vosk":
            # Legacy backend still uses SIGSTOP readiness.
            for _ in range(300):
                if not self.alive():
                    return False
                if proc_state(self.proc.pid) == "T":
                    return True
                time.sleep(0.1)
            self.stop()
            return False

        for _ in range(300):
            if not self.alive():
                log("engine exited during startup (rc=%s)" % self.proc.returncode)
                return False
            try:
                with open(READY, "r", encoding="utf-8") as fh:
                    ready_pid = int(fh.read().strip())
            except (OSError, ValueError):
                ready_pid = -1
            if ready_pid == self.proc.pid:
                log("engine ready pid=%d" % self.proc.pid)
                return True
            time.sleep(0.05)

        log("engine did not become ready")
        self.stop()
        return False

    def stop(self):
        if self.proc is None:
            return
        pid = self.proc.pid
        if self.proc.poll() is None:
            try:
                os.killpg(pid, signal.SIGTERM)
            except OSError:
                pass
            deadline = time.monotonic() + 2
            while self.proc.poll() is None and time.monotonic() < deadline:
                time.sleep(0.05)
            if self.proc.poll() is None:
                try:
                    os.killpg(pid, signal.SIGKILL)
                except OSError:
                    pass
        try:
            self.proc.wait(timeout=2)
        except Exception:
            pass
        self.proc = None

    def resume(self):
        if not self.alive():
            return
        if ENGINE_MODE == "vosk":
            os.kill(self.proc.pid, signal.SIGCONT)
        else:
            os.kill(self.proc.pid, signal.SIGUSR2)
        log("recording requested")

    def suspend(self):
        if not self.alive():
            return
        try:
            os.kill(self.proc.pid, signal.SIGUSR1)
            log("stop requested")
        except ProcessLookupError:
            pass


def single_instance():
    fh = open(LOCK, "w")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError as ex:
        if ex.errno in (errno.EACCES, errno.EAGAIN):
            log("another baogu-ptt is already running")
            sys.exit(0)
        raise
    return fh


def main():
    if shutil.which("xinput") is None:
        log("xinput not found")
        return 1
    if ENGINE_MODE == "sherpa" and not os.path.isfile(SHERPA_ENGINE):
        log("baogu-engine not found")
        return 1
    if ENGINE_MODE == "vosk" and not os.path.isdir(VOSK_MODEL):
        log("Vosk model not found")
        return 1

    _lock = single_instance()
    os.environ.setdefault("DISPLAY", ":1")
    engine = Engine()
    stopping = {"now": False}

    def shutdown(_sig=None, _frm=None):
        stopping["now"] = True
        engine.stop()
        for path in (COOKIE, READY, STATE):
            try:
                os.unlink(path)
            except OSError:
                pass
        log("stopped")
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)

    if not engine.start():
        return 1

    held = False
    asking = False
    while not stopping["now"]:
        try:
            ids = subprocess.check_output(
                ["xinput", "list", "--id-only", "Virtual core XTEST keyboard"],
                env=child_env(), text=True, timeout=5,
            )
            synthetic_devices = {int(v) for v in ids.split()}
        except Exception as ex:
            log("cannot resolve XTEST keyboard: %r" % ex)
            time.sleep(1)
            continue

        shortcut = CorrectionShortcut()
        ask = AskShortcut()
        hotword = AskShortcut(HOTWORD_KEYCODE, HOTWORD_MODIFIER)
        events = KeyEvents(synthetic_devices)
        watcher = subprocess.Popen(
            ["stdbuf", "-oL", "xinput", "test-xi2", "--root"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, env=child_env(),
        )
        assert watcher.stdout is not None

        for line in watcher.stdout:
            parsed = events.feed(line)
            if parsed is None:
                continue
            event, keycode = parsed
            if shortcut.feed(event, keycode):
                try:
                    enabled = toggle_llm(os.environ.get("BAOGU_LLM_ENABLED", "1") == "1")
                    with open(os.path.join(RUNTIME, "baogu-correction.state"), "w", encoding="utf-8") as fh:
                        json.dump({"session": "toggle", "status": "enabled" if enabled else "disabled", "time": time.time()}, fh)
                    log("DeepSeek correction " + ("enabled" if enabled else "disabled"))
                except OSError as ex:
                    log("cannot save DeepSeek toggle: %r" % ex)
            hotword_action = hotword.feed(event, keycode)
            if hotword_action == "press":
                # The rebuild inside baogu-hotwords blocks this loop for a
                # moment; keys stay buffered in the pipe, so nothing is lost.
                # Log the gate before acting: "nothing happened" and "the
                # combo never fired" look identical from the outside.
                log("hotword combo: held=%s asking=%s enabled=%s"
                    % (held, asking, HOTWORD_ENABLED))
                if not held and not asking and HOTWORD_ENABLED:
                    add_hotword_from_selection()
            action = ask.feed(event, keycode)
            if action == "press":
                if held or asking or not ASK_ENABLED:
                    continue
                # Read the clipboard before the selection probe: the fallback
                # path rewrites the clipboard and then restores it, and a
                # silent press wants whatever the user actually copied.
                clipboard = capture_clipboard()
                selection = capture_selection()
                # Start the engine before writing the request: a cold start
                # clears stale ask files in its own initialization.
                if not engine.alive() and not engine.start():
                    continue
                write_ask_request(selection, clipboard)
                asking = True
                ensure_ask_window()
                log("ask requested selection_chars=%d clipboard_chars=%d"
                    % (len(selection), len(clipboard)))
                engine.resume()
            elif action == "release":
                if asking:
                    asking = False
                    engine.suspend()
            if keycode != KEYCODE:
                continue

            if event == "RawKeyPress":
                if held:
                    continue
                held = True
                if not engine.alive() and not engine.start():
                    held = False
                    continue
                engine.resume()
            else:
                if not held:
                    continue
                held = False
                # Never wait here. This is what keeps the next press responsive.
                engine.suspend()

        watcher.wait()
        if stopping["now"]:
            break
        held = False
        asking = False
        engine.suspend()
        log("xinput watcher exited; restarting")
        time.sleep(1)

    shutdown()
    return 0


if __name__ == "__main__":
    sys.exit(main())
